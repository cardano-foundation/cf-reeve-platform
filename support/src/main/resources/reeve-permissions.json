  "organisationRole": "org_member",
  "roles": {
    "org_member": {
      "description": "Member of the organisation: organisation details and settings, read-only. Assigned on the organisation group, so every member has it.",
      "permissions": [
        "settings:view",
        "organization:view",
        "organization_details:view",
        "currencies:view"
      ]
    },
    "org_admin": {
      "description": "Edit the organisation details and currencies.",
      "permissions": [
        "organization_details:edit",
        "currencies:create",
        "currencies:edit"
      ]
    },
    "transactions_viewer": {
      "description": "Transactions module: transactions, batches, reconciliation status, data explorer, setup data, read-only.",
      "permissions": [
        "transactions:view",
        "transactions:export",
        "transactions:batches_view",
        "transactions:reconcilate_view",
        "data_explorer:view",
        "data_explorer:dashboard_view",
        "data_explorer:search_view",
        "chart_of_accounts:view",
        "event_codes:view",
        "cost_centers:view",
        "projects:view",
        "vat_codes:view",
        "export_setup_data:view"
      ]
    },
    "transactions_setup": {
      "description": "Transactions module: configure chart of accounts, event/reference codes, cost centers, project codes, VAT codes, currencies; import/export setup data.",
      "permissions": [
        "chart_of_accounts:create",
        "chart_of_accounts:edit",
        "event_codes:create",
        "event_codes:edit",
        "cost_centers:create",
        "cost_centers:edit",
        "projects:create",
        "projects:edit",
        "vat_codes:create",
        "vat_codes:edit",
        "currencies:create",
        "currencies:edit",
        "organization_setup:view",
        "organization_setup:import",
        "export_setup_data:download"
      ]
    },
    "transactions_erp": {
      "description": "Transactions module: configure the ERP (NetSuite) connection.",
      "permissions": [
        "netsuite_configuration:view",
        "netsuite_configuration:create",
        "netsuite_configuration:edit"
      ]
    },
    "transactions_importer": {
      "description": "Transactions module: import/extract from the ERP and reprocess batches.",
      "permissions": [
        "transactions:import_view",
        "transactions:import",
        "transactions:batches_reprocess"
      ]
    },
    "transactions_reviewer": {
      "description": "Transactions module: review (approve/reject) transactions.",
      "permissions": [
        "transactions:review_view",
        "transactions:review_approve",
        "transactions:review_reject"
      ]
    },
    "transactions_reconciler": {
      "description": "Transactions module: run the reconciliation.",
      "permissions": [
        "transactions:reconcilate"
      ]
    },
    "transactions_publisher": {
      "description": "Transactions module: publish (approve/reject) transactions.",
      "permissions": [
        "transactions:publish_view",
        "transactions:publish_approve",
        "transactions:publish_reject"
      ]
    },
    "reports_viewer": {
      "description": "Reporting module: reports, templates, chart of accounts and accounting regimes, read-only.",
      "permissions": [
        "reports:view",
        "report_templates:view",
        "chart_of_accounts:view",
        "accounting_regimes:view"
      ]
    },
    "reports_setup": {
      "description": "Reporting module: configure accounting regimes and report type field mappings.",
      "permissions": [
        "accounting_regimes:create",
        "accounting_regimes:edit",
        "report_types:edit"
      ]
    },
    "reports_editor": {
      "description": "Reporting module: create, edit, generate and delete reports and report templates.",
      "permissions": [
        "reports:create",
        "reports:edit",
        "reports:delete",
        "reports:preview",
        "report_templates:create",
        "report_templates:edit",
        "report_templates:delete"
      ]
    },
    "reports_publisher": {
      "description": "Reporting module: publish/reject reports.",
      "permissions": [
        "reports:publish_view",
        "reports:publish",
        "reports:reject"
      ]
    },
    "funding_viewer": {
      "description": "Funding module: projects and spending events, read-only.",
      "permissions": [
        "project_management:view"
      ]
    },
    "funding_project_manager": {
      "description": "Funding module: create, edit and delete projects and milestones, bulk import; delete events.",
      "permissions": [
        "project_management:create_project",
        "project_management:delete"
      ]
    },
    "funding_event_editor": {
      "description": "Funding module: create and edit spending events.",
      "permissions": [
        "project_management:create",
        "project_management:edit"
      ]
    },
    "funding_publisher": {
      "description": "Funding module: publish spending events.",
      "permissions": [
        "project_management:publish"
      ]
    }
  },
  "presets": {
